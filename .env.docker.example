# Copy this file to .env.docker and replace every example secret.
POSTGRES_DB=payroll_lite
POSTGRES_USER=payroll
POSTGRES_PASSWORD=replace-with-a-strong-database-password

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=86400000

# Required only to create the first administrator in a new Docker volume.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# Host bindings. PostgreSQL remains private to the Compose network.
API_BIND_ADDRESS=127.0.0.1
API_PORT=9090
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
